      },
      "targets": [
        {
          "expr": "sum by (kind) (increase(ncf_storefront_http_requests_total[$__range]))",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ],
      "title": "Volume por tipo no período",
      "type": "bargauge"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "id": 6,
