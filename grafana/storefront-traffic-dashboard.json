        "legend": {
          "calcs": [
            "sum"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (kind, status) (increase(ncf_storefront_http_requests_total[$__range]))",
          "format": "table",
          "instant": true,
          "legendFormat": "{{kind}} · {{status}}",
          "refId": "A"
        }
      ],
      "title": "Chamadas por tipo e status",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {},
            "renameByName": {
              "Value": "Chamadas"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "Acumula incrementos estimados em blocos sem sobreposição desde o início do intervalo selecionado. Não é uma janela móvel de 24h. Blocos completos têm no mínimo 4 minutos para a coleta de 60s; frações nas bordas e dados ausentes não são reconstruídos. O valor final pode diferir do cartão de total do período.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 15,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 46
      },
      "id": 9,
      "maxDataPoints": 100,
      "interval": "4m",
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "sum(clamp_min(increase(ncf_storefront_http_requests_total[$__interval]), 0)) and on() (vector(time()) >= (${__from:date:seconds} + $__interval_ms / 1000))",
          "interval": "4m",
          "instant": false,
          "range": true,
          "legendFormat": "Chamadas",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "calculateField",
          "options": {
            "mode": "cumulativeFunctions",
            "cumulative": {
              "reducer": "sum"
            },
            "alias": "Acumulado",
            "replaceFields": true
          }
        }
      ],
      "title": "Chamadas acumuladas no período · estimativa",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "Top 10 lojas por chamadas recebidas no período. Os nomes vêm do cadastro, associados por store_id. Requisições sem loja validada e downloads servidos pela CDN não entram. Requer a métrica ncf_store_info da nova versão do app.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "id": 7,
      "options": {
        "displayMode": "gradient",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "sizing": "auto",
        "text": {},
        "valueMode": "color"
      },
      "targets": [
        {
          "expr": "topk(10, sum by (store_id) (increase(ncf_storefront_store_requests_total[$__range]) or increase(ncf_storefront_http_requests_total{store_id=~\"[0-9]+\"}[$__range])) * on (store_id) group_left (store_name) topk by (store_id) (1, max by (store_id, store_name) (last_over_time(ncf_store_info[$__range]))))",
          "instant": true,
          "legendFormat": "{{store_name}}",
          "refId": "A"
        }
      ],
      "title": "Top 10 lojas por chamadas no período",
      "type": "bargauge"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "Top 20 produtos ativos com campos de personalização por consultas bem-sucedidas de configuração no período selecionado. Não são visitantes únicos: recargas, bots e novas consultas podem aumentar o total. A coleta começa após o deploy desta versão.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "id": 8,
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Quantidade",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "expr": "round(sort_desc(topk(20, (sum by (store_id, product_id) (increase(ncf_storefront_personalized_product_requests_total[$__range])) > 0) * on (store_id, product_id) group_left (store_name, product_name) topk by (store_id, product_id) (1, max by (store_id, product_id, store_name, product_name) (ncf_personalized_product_info)))))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Produtos personalizados mais consultados · Loja / Produto / Quantidade",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "store_id": true,
              "product_id": true
            },
            "indexByName": {
              "store_name": 0,
              "product_name": 1,
              "Value": 2
            },
            "renameByName": {
              "store_name": "Loja",
              "product_name": "Produto",
              "Value": "Quantidade"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Saúde da coleta · principal",
      "datasource": "${DS_PROMETHEUS}",
      "description": "1 = última coleta bem-sucedida; 0 = coleta falhou. Ausência de dados não comprova tráfego zero. Não mede diretamente disponibilidade pública.",
