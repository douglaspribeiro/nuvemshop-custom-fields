              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 16
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "100 * sum(increase(ncf_storefront_http_requests_total{status=~\"5..\"}[$__range])) / clamp_min(sum(increase(ncf_storefront_http_requests_total[$__range])), 1)",
          "refId": "A"
        }
      ],
      "title": "Erros 5xx no período",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
