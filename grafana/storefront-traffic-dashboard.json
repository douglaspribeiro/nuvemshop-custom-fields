    {
      "id": 11,
      "type": "stat",
      "title": "Cobertura de amostras · principal",
      "datasource": "${DS_PROMETHEUS}",
      "description": "Estimativa de amostras presentes versus esperadas com scrape de 60s. Inclui amostras up=0; saúde e cobertura devem ser avaliadas juntas. As bordas do intervalo podem afetar o percentual.",
      "gridPos": {
        "x": 12,
        "y": 54,
        "w": 12,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "clamp_max(100 * sum(count_over_time(up{job=\"app-custom-fields\"}[$__range])) / ($__range_s / 60), 100)",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 58
      },
      "id": 12,
      "maxDataPoints": 100,
      "interval": "1m",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
