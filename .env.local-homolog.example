# Copie para .env.local-homolog (ignorado pelo Git). Nunca copie o .env de produção.
LOCAL_HOMOLOG_ACCESS_KEY=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_DE_32_CARACTERES
APP_BASE_URL=http://localhost:8080
# Pode iniciar com false para testar o painel e as sugestões antes de configurar a Efí.
EFI_ENABLED=false
EFI_SANDBOX=true
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_PAYEE_CODE=
EFI_PREMIUM_PLAN_ID=
EFI_PREMIUM_PLUS_PLAN_ID=
EFI_PREMIUM_ULTRA_PLAN_ID=
EFI_PREMIUM_AMOUNT=19.99
EFI_PREMIUM_PLUS_AMOUNT=29.99
EFI_PREMIUM_ULTRA_AMOUNT=59.90
UPGRADE_BRINDE_ENABLED=true
# Configure credenciais locais diferentes das de produção.
BACKOFFICE_USERNAME=admin-local
BACKOFFICE_PASSWORD=SUBSTITUA_POR_UMA_SENHA_LOCAL
# Opcional: use um canal de Discord exclusivo para testes.
DISCORD_SUPPORT_WEBHOOK_URL=
DISCORD_PAYMENT_WEBHOOK_URL=
